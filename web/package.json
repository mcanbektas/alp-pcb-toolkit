{
  "name": "alp-pcb-toolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "stack": "node scripts/dev-stack.mjs",
    "stack:docker": "docker compose -f ../deploy/docker-compose.yml up -d --build",
    "stack:docker:down": "docker compose -f ../deploy/docker-compose.yml down",
    "build": "vite build && vite build --ssr scripts/prerender/entry-server.jsx --outDir .prerender && node scripts/build-prerender.mjs && node scripts/build-sitemap.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.js",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
